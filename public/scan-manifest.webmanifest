{
  "id": "/scan",
  "name": "Libriofy Smart Entry",
  "short_name": "Smart Entry",
  "description": "Premium kiosk scanner for fast QR-based library entry and attendance tracking.",
  "start_url": "/scan",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display_override": ["fullscreen", "standalone"],
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06091d",
  "theme_color": "#06091d",
  "categories": ["business", "education"],
  "prefer_related_applications": false,

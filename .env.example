# Libriofy application runtime
# Copy to .env for local development. Production and staging secrets belong in Vercel, Render, Supabase, and GitHub environment secrets.

# Frontend public runtime
# Leave VITE_AUTH_API_BASE empty for same-origin Vercel/serverless auth.
# Set it only when auth is served from a separate upstream host such as api.example.com.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_AUTH_API_BASE=https://api-staging.example.com
VITE_API_BASE_URL=https://api-staging.example.com
VITE_SCAN_API_URL=https://api-staging.example.com/api/attendance/scan
VITE_DEVICE_HEARTBEAT_API_URL=https://api-staging.example.com/api/device-heartbeat
VITE_STUDENT_QR_API_URL=https://api-staging.example.com/api/student-qr
VITE_QR_PUBLIC_KEY=your_public_qr_key
VITE_STUDENT_QR_PUBLIC_KEY=your_public_qr_key
VITE_RAZORPAY_KEY_ID=rzp_test_example
VITE_PUBLIC_APP_URL=https://staging.example.com
VITE_APP_URL=https://staging.example.com
VITE_APP_ENV=staging
VITE_RELEASE_SHA=local
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_USE_HASH_ROUTER=false
VITE_BASE_PATH=/
VITE_SUPPORT_WHATSAPP=919876543210
VITE_PRODUCT_DEMO_VIDEO_URL=
VITE_PRODUCT_DEMO_EMBED_URL=
VITE_SUPABASE_PROJECT_ID=

# Optional kiosk/device runtime
VITE_SCAN_DEVICE_ID=LIB_GATE_01
VITE_SCAN_DEVICE_NAME=Front Desk Scanner
VITE_SCAN_DEVICE_TOKEN=
VITE_SCAN_ADMIN_PIN=123456
VITE_DEVICE_ADMIN_PIN=123456
VITE_ENABLE_DEVICE_COMMANDS=true
VITE_MAINTENANCE_MODE=false

# Backend runtime
PORT=3001
APP_ENV=staging
RELEASE_SHA=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STUDENT_QR_PRIVATE_KEY=your_private_qr_key
STUDENT_QR_PUBLIC_KEY=your_public_qr_key
PUBLIC_APP_URL=https://app.example.com
APP_URL=https://app.example.com
SITE_URL=https://app.example.com
AUTH_DEFAULT_COUNTRY_CODE=+91
MAINTENANCE_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0

# Copy this file to .env.ops and fill in production values.
# This file is read by backup, restore, monitoring, and scheduler scripts.

OPS_OWNER_NAME=system-owner

# Linked Supabase backup source
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Restore targets
RESTORE_DB_URL=postgresql://postgres:password@prod-host:5432/postgres
RESTORE_STAGING_DB_URL=postgresql://postgres:password@staging-host:5432/postgres

# Offsite backup storage
BACKUP_REQUIRE_OFFSITE=true
BACKUP_S3_URI=s3://your-bucket/libriofy
BACKUP_RCLONE_REMOTE=gdrive:libriofy-backups
BACKUP_SUPABASE_BUCKET=ops-backups
BACKUP_SUPABASE_PATH=database
BACKUP_SUPABASE_URL=https://your-project.supabase.co
BACKUP_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Alerting options
OPS_ALERT_WEBHOOK_URL=https://your-alert-endpoint.example.com/libriofy
OPS_ALERT_EMAIL_FROM=hello@libriofy.com
OPS_ALERT_EMAIL_TO=ops@example.com
OPS_ALERT_SMTP_HOST=smtp.resend.com
OPS_ALERT_SMTP_PORT=587
OPS_ALERT_SMTP_USERNAME=resend
OPS_ALERT_SMTP_PASSWORD=your_resend_api_key
OPS_ALERT_SMTP_USE_SSL=true
OPS_ALERT_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPS_ALERT_TWILIO_AUTH_TOKEN=your_twilio_auth_token
OPS_ALERT_TWILIO_FROM=whatsapp:+14155238886
OPS_ALERT_TWILIO_TO=whatsapp:+919876543210

# Remote health endpoints for ops:health and scheduled uptime checks
HEALTHCHECK_PRODUCTION_FRONTEND_URL=https://app.example.com
HEALTHCHECK_PRODUCTION_API_URL=https://api.example.com/health/ready
HEALTHCHECK_STAGING_FRONTEND_URL=https://staging.example.com
HEALTHCHECK_STAGING_API_URL=https://api-staging.example.com/health/ready

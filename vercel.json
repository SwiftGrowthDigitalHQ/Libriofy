{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/**/*.ts": {
      "includeFiles": "src/lib/**"
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://api.openai.com https://api.razorpay.com; frame-src 'self' https://api.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(self), display-capture=(), usb=(), bluetooth=(), serial=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/send-otp",
      "destination": "/api/auth/send-otp"
    },
    {
      "source": "/auth/verify-otp",
      "destination": "/api/auth/verify-otp"
    },
    {
      "source": "/auth/login-email",
      "destination": "/api/auth/login-email"
    },
    {
      "source": "/auth/super-admin/login",
      "destination": "/api/auth/super-admin/login"
    },
    {
      "source": "/auth/super-admin/verify-otp",
      "destination": "/api/auth/super-admin/verify-otp"
    },
    {
      "source": "/auth/super-admin/verify",
      "destination": "/api/auth/super-admin/verify"
    },
    {
      "source": "/auth/refresh",
      "destination": "/api/auth/refresh"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/auth/logout"
    },
    {
      "source": "/auth/logout-all",
      "destination": "/api/auth/logout-all"
    },
    {
      "source": "/auth/twilio-status",
      "destination": "/api/auth/twilio-status"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/health/live",
      "destination": "/api/health/live"
    },
    {
      "source": "/health/ready",
      "destination": "/api/health/ready"
    },
    {
      "source": "/health/ops",
      "destination": "/api/health/ops"
    },
    {
      "source": "/health/db",
      "destination": "/api/health/db"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|robots.txt|sitemap.xml|service-worker.js|manifest.webmanifest|release.json).*)",
      "destination": "/index.html"
    }
  ]
}
